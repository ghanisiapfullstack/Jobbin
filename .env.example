APP_NAME=Jobbin
APP_ENV=local
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=3000
APP_KEY=replace-with-random-32-char-key!
RUN_IN_PROCESS_JOBS=true

JWT_SECRET=your-32-char-jwt-secret-here!!!
JWT_TTL=60

CORS_ALLOWED_ORIGINS=https://www.jobbin.site,http://localhost:5173

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jobbin
DB_USERNAME=jobbin
DB_PASSWORD=jobbin_secret
DB_SSLMODE=disable
DB_SCHEMA=public
DB_MAX_IDLE_CONNS=2
DB_MAX_OPEN_CONNS=10
DB_CONN_MAX_IDLE_TIME=300
DB_CONN_MAX_LIFETIME=1800

RESEND_API_KEY=re_xxxxx
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=Jobbin

FRONTEND_URL=http://localhost:5173
